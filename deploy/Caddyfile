# Вход снаружи: HTTPS, статика фронта и прокси на api.
#
# Почему Caddy, а не nginx: сертификат Let's Encrypt он получает и продлевает
# сам, без cron и certbot. Нам это важнее гибкости: HTTPS здесь не украшение,
# а условие работы — кука сессии выставляется с флагом Secure, и по http
# вход просто не состоится.

{$EDS_DOMAIN} {
	encode zstd gzip

	# API — всё, что под /api, уходит в процесс api.
	handle /api/* {
		reverse_proxy api:8000 {
			# Поток к интерфейсу (SSE) не должен копиться в буфере прокси:
			# иначе блокировка доезжала бы до экрана пачкой и с задержкой,
			# то есть ровно так, как было до шага «Живое обновление».
			flush_interval -1
		}
	}

	# Страница состояния живёт в том же процессе.
	handle /status {
		reverse_proxy api:8000
	}

	# Всё остальное — собранный фронт. try_files нужен из-за того, что
	# маршруты SPA (/today, /admin, /trades) на диске не существуют:
	# без него прямое открытие адреса давало бы 404 от файлового сервера.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
