# Серверный .env. Скопируй на машине в .env рядом с docker-compose.prod.yml
# и заполни. В git этот файл не попадает никогда.

# --- база ---
POSTGRES_USER=eds
# Длинный случайный пароль, а не локальный: база хоть и не торчит наружу,
# но машина публичная. Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=eds
DATABASE_URL=postgresql+asyncpg://eds:ТОТ_ЖЕ_ПАРОЛЬ@db:5432/eds

# --- приложение ---
EDS_ENV=server
EDS_LOG_LEVEL=INFO

# Мастер-ключ шифрования ключей источников и токена бота.
# Сгенерировать: docker compose -f docker-compose.prod.yml run --rm --no-deps api python -m eds.entrypoints.genkey
# Менять нельзя: после смены сохранённые ключи не расшифруются.
EDS_SECRET_KEY=

# Токен бота Telegram, из @BotFather. Без него не работают ни уведомления,
# ни вход в админку.
EDS_BOT_TOKEN=

# Почта админа. Признак админа ставится этому пользователю при каждом старте,
# поэтому сначала зарегистрируйся в интерфейсе, потом впиши адрес сюда.
EDS_ADMIN_EMAIL=

# --- имя сервиса ---
# Имя, на которое Caddy выпишет сертификат. Без своего домена подойдёт
# sslip.io: он отдаёт адрес машины по имени. Для 130.61.1.2 это будет
# 130-61-1-2.sslip.io
EDS_DOMAIN=
