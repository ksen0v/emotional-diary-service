# Скопируй в .env и заполни. Файл .env в git не попадает.

# --- база ---
POSTGRES_USER=eds
POSTGRES_PASSWORD=eds_local_password
POSTGRES_DB=eds
# для приложения внутри docker-compose хост базы — имя сервиса "db"
DATABASE_URL=postgresql+asyncpg://eds:eds_local_password@db:5432/eds

# --- приложение ---
EDS_ENV=local
EDS_LOG_LEVEL=INFO

# мастер-ключ шифрования ключей источников (TMM, Binance).
# Сгенерировать: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
EDS_SECRET_KEY=

# --- источники (появятся на шаге 4 и 14) ---
TMM_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
