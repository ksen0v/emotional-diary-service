# Скопируй в .env и заполни. Файл .env в git не попадает.

# --- база ---
POSTGRES_USER=eds
POSTGRES_PASSWORD=eds_local_password
POSTGRES_DB=eds
# для приложения внутри docker-compose хост базы — имя сервиса "db"
DATABASE_URL=postgresql+asyncpg://eds:eds_local_password@db:5432/eds

# --- приложение ---
EDS_ENV=local
EDS_LOG_LEVEL=INFO

# Мастер-ключ шифрования ключей источников. Без него подключить TMM нельзя.
# Сгенерировать: docker compose run --rm --no-deps api python -m eds.entrypoints.genkey
# Менять нельзя: после смены уже сохранённые ключи источников не расшифруются,
# и источники придётся подключать заново.
EDS_SECRET_KEY=

# --- источники ---
# Ключей источников здесь нет и не будет: трейдер вводит ключ в интерфейсе,
# сервис шифрует его и хранит в базе. В переменных окружения ключ жил бы
# открытым текстом и попадал бы в логи docker.
